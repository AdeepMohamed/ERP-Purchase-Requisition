# Neon serverless PostgreSQL connection string
# Get this from your Neon project dashboard → Connection Details → Connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# JWT secret — use a strong random string in production (e.g., openssl rand -hex 64)
JWT_SECRET="change-me-before-committing"
JWT_EXPIRES_IN="8h"

# Server config
PORT=4000
NODE_ENV=development

# CORS — frontend origin allowed to call the API
CORS_ORIGIN="http://localhost:5173"
